{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "🚀 Features & Capabilities", "hidden": false },
    { "type": "fix", "section": "🐛 Bug Fixes & Stability", "hidden": false },
    { "type": "perf", "section": "⚡ Performance & Smoothness", "hidden": false },
    { "type": "security", "section": "🛡️ Security & Privacy", "hidden": false },
    { "type": "docs", "section": "📚 Documentation & Guides", "hidden": false },
    { "type": "refactor", "section": "♻️ Architecture & Refactoring", "hidden": false },
    { "type": "test", "section": "🧪 Tests & Quality", "hidden": false },
    { "type": "ci", "section": "⚙️ CI/CD & Release Engineering", "hidden": false },
    { "type": "build", "section": "📦 Build & Packaging", "hidden": false },
    { "type": "chore", "section": "🔧 Maintenance & Dependencies", "hidden": false }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "drishti-browser-ai",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/chrome-extension/public/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/chrome-extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web-showcase/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/local-bridge/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/mcp-server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/browser-core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/dom-engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/mcp-tools/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/permission-engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/shared-types/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/visual-engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/workflow-engine/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
