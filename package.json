{
  "name": "drishti-browser-ai",
  "version": "0.1.3",
  "private": true,
  "description": "Drishti Browser AI (दृष्टि) — Universal AI Browser Automation Platform (Chrome Extension + MCP Server)",
  "license": "MIT",
  "author": "Sudhir",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel -r run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/extension.smoke.mjs",
    "test:live": "node scripts/live-test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "version:bump": "node scripts/version.mjs bump",
    "version:sync": "node scripts/version.mjs sync",
    "version:verify": "node scripts/version.mjs verify",
    "tools:sync": "node scripts/sync-tools.mjs",
    "bridge:start": "pnpm --filter local-bridge run start",
    "mcp:start": "pnpm --filter mcp-server run start",
    "setup:agent": "node scripts/setup-agent.mjs",
    "native:install": "node scripts/install-native-host.mjs",
    "native:uninstall": "node scripts/install-native-host.mjs --uninstall",
    "ext:build": "pnpm --filter chrome-extension run build",
    "ext:dev": "pnpm --filter chrome-extension run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.50.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
